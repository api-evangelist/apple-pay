                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantIdentifier\": \"<string>\",\n  \"displayName\": \"<string>\",\n  \"initiative\": \"<string>\",\n  \"initiativeContext\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
