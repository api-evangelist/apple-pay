  "info": {
    "_postman_id": "4a12c581-6ce2-4dc4-95ce-0f67e41f7f81",
    "name": "Apple Pay JS Merchant Registration Payment Processing API",
    "description": "Server-side REST API used in conjunction with the Apple Pay JS client-side JavaScript API for processing Apple Pay payments on the web. Merchants call Apple's payment gateway to validate their merchant identity and obtain a payment session, which is then used by the client-side ApplePaySession to authorize payments via Touch ID or Face ID in Safari.\n\nContact Support:\n Name: Apple Developer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:03:34.000Z",
